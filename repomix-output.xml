<file path="src/pages/Dashboard.jsx">
import { useEffect, useState } from "react";
import { useSelector } from "react-redux";
import { supabase } from "../lib/supabaseClient";
import PitchCard from "../components/PitchCard";
import { Link } from "react-router";

function Dashboard() {
  const { user, profile } = useSelector((state) => state.auth);
  const [myPitches, setMyPitches] = useState([]);
  const [myInterests, setMyInterests] = useState([]);
  const [loading, setLoading] = useState(true);

  const fetchMyPitches = async () => {
    setLoading(true);
    const { data } = await supabase
      .from("pitches")
      .select("*")
      .eq("owner_id", user.id)
      .order("created_at", { ascending: false });
    setMyPitches(data || []);
    setLoading(false);
  };

  const fetchMyInterests = async () => {
    setLoading(true);
    const { data } = await supabase
      .from("interests")
      .select("*, pitches(*)")
      .eq("investor_id", user.id);
    setMyInterests(data || []);
    setLoading(false);
  };

  useEffect(() => {
    if (profile?.role === "owner") fetchMyPitches();
    if (profile?.role === "investor") fetchMyInterests();
  }, [profile]);

  const deletePitch = async (id) => {
    if (!confirm("Delete this pitch?")) return;
    await supabase.from("pitches").delete().eq("id", id);
    setMyPitches((prev) => prev.filter((p) => p.id !== id));
  };

  return (
    <div className="max-w-5xl mx-auto px-6 py-10">
      <h1 className="text-3xl font-bold text-gray-800 mb-2">My Dashboard</h1>
      <p className="text-gray-500 mb-8">
        Hello, <strong>{profile?.full_name}</strong> — you are logged in as a{" "}
        <span className="text-indigo-600 font-semibold">{profile?.role}</span>
      </p>

      {profile?.role === "owner" && (
        <>
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-xl font-semibold text-gray-700">My Pitches</h2>
            <Link
              to="/create-pitch"
              className="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm"
            >
              + New Pitch
            </Link>
          </div>
          {loading ? (
            <p className="text-gray-400">Loading...</p>
          ) : myPitches.length === 0 ? (
            <p className="text-gray-400">
              You haven't created any pitches yet.
            </p>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {myPitches.map((pitch) => (
                <div key={pitch.id} className="relative">
                  <PitchCard pitch={pitch} />
                  <button
                    onClick={() => deletePitch(pitch.id)}
                    className="absolute top-3 right-3 text-xs text-red-500 hover:text-red-700"
                  >
                    Delete
                  </button>
                </div>
              ))}
            </div>
          )}
        </>
      )}

      {profile?.role === "investor" && (
        <>
          <h2 className="text-xl font-semibold text-gray-700 mb-4">
            Pitches I'm Interested In
          </h2>
          {loading ? (
            <p className="text-gray-400">Loading...</p>
          ) : myInterests.length === 0 ? (
            <p className="text-gray-400">
              You haven't expressed interest in any pitch yet.
            </p>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {myInterests.map((item) => (
                <PitchCard key={item.id} pitch={item.pitches} />
              ))}
            </div>
          )}
        </>
      )}
    </div>
  );
}

export default Dashboard;
</file>

<file path="src/pages/Home.jsx">
import { useEffect, useState } from "react";
import { supabase } from "../lib/supabaseClient";
import PitchCard from "../components/PitchCard";

function Home() {
  const [pitches, setPitches] = useState([]);
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);

  const fetchPitches = async () => {
    setLoading(true);
    const { data, error } = await supabase
      .from("pitches")
      .select("*")
      .order("created_at", { ascending: false });
    if (!error) setPitches(data);
    setLoading(false);
  };

  useEffect(() => {
    fetchPitches();
  }, []);

  const filtered = pitches.filter(
    (p) =>
      p.title.toLowerCase().includes(search.toLowerCase()) ||
      (p.category || "").toLowerCase().includes(search.toLowerCase()),
  );

  return (
    <div className="max-w-6xl mx-auto px-6 py-10">
      <h1 className="text-3xl font-bold text-gray-800 mb-2">Explore Pitches</h1>
      <p className="text-gray-500 mb-6">
        Discover investment opportunities from product owners.
      </p>

      <input
        type="text"
        placeholder="Search by title or category..."
        value={search}
        onChange={(e) => setSearch(e.target.value)}
        className="w-full border border-gray-300 rounded-lg px-4 py-2 mb-8 focus:outline-none focus:ring-2 focus:ring-indigo-400"
      />

      {loading ? (
        <p className="text-gray-400">Loading pitches...</p>
      ) : filtered.length === 0 ? (
        <p className="text-gray-400">No pitches found.</p>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {filtered.map((pitch) => (
            <PitchCard key={pitch.id} pitch={pitch} />
          ))}
        </div>
      )}
    </div>
  );
}

export default Home;
</file>

